import matplotlib.pyplot as plt

# Training dataset
# Attributes:
# Sky, AirTemp, Humidity, Wind, Water, Forecast
# Last column = EnjoySport

training_data = [
    ['Sunny', 'Warm', 'Normal', 'Strong', 'Warm', 'Same', 'Yes'],
    ['Sunny', 'Warm', 'High',   'Strong', 'Warm', 'Same', 'Yes'],
    ['Rainy', 'Cold', 'High',   'Strong', 'Warm', 'Change', 'No'],
    ['Sunny', 'Warm', 'High',   'Strong', 'Cool', 'Change', 'Yes']
]

attribute_names = [
    'Sky',
    'AirTemp',
    'Humidity',
    'Wind',
    'Water',
    'Forecast'
]

# Initial hypothesis
hypothesis = ['0'] * len(attribute_names)

# Store hypothesis changes for graph
hypothesis_history = []
positive_example_numbers = []

print("FIND-S ALGORITHM")
print("-" * 50)

print("Initial Hypothesis:", hypothesis)

# FIND-S algorithm
for i, example in enumerate(training_data, start=1):

    # Check whether example is positive
    if example[-1] == 'Yes':

        for j in range(len(attribute_names)):

            # First positive example
            if hypothesis[j] == '0':
                hypothesis[j] = example[j]

            # If values are different, generalize to '?'
            elif hypothesis[j] != example[j]:
                hypothesis[j] = '?'

        # Store the current hypothesis
        hypothesis_history.append(hypothesis.copy())
        positive_example_numbers.append(i)

        print("After Example", i, ":", hypothesis)

print("\nFinal Most Specific Hypothesis:")
print(hypothesis)

# ------------------------------------------------
# Convert hypothesis into numerical values for graph
# 0       = 0
# Specific attribute = 1
# '?'     = 2
# ------------------------------------------------

graph_values = []

for h in hypothesis_history:

    values = []

    for value in h:
        if value == '0':
            values.append(0)
        elif value == '?':
            values.append(2)
        else:
            values.append(1)

    graph_values.append(values)

# ------------------------------------------------
# Plot graph
# ------------------------------------------------

plt.figure(figsize=(10, 6))

for i, attribute in enumerate(attribute_names):

    values = [row[i] for row in graph_values]

    plt.plot(
        positive_example_numbers,
        values,
        marker='o',
        linewidth=2,
        label=attribute
    )

plt.yticks(
    [0, 1, 2],
    ['Initial (0)', 'Specific Value', 'Generalized (?)']
)

plt.xlabel("Positive Training Example")
plt.ylabel("Hypothesis State")
plt.title("FIND-S Algorithm - Hypothesis Evolution")

plt.grid(True, linestyle='--', alpha=0.5)
plt.legend()
plt.tight_layout()

plt.show()
