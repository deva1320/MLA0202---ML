      "source": [
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Training dataset\n",
        "# Attributes:\n",
        "# Sky, AirTemp, Humidity, Wind, Water, Forecast\n",
        "# Last column = EnjoySport\n",
        "\n",
        "training_data = [\n",
        "    ['Sunny', 'Warm', 'Normal', 'Strong', 'Warm', 'Same', 'Yes'],\n",
        "    ['Sunny', 'Warm', 'High',   'Strong', 'Warm', 'Same', 'Yes'],\n",
        "    ['Rainy', 'Cold', 'High',   'Strong', 'Warm', 'Change', 'No'],\n",
        "    ['Sunny', 'Warm', 'High',   'Strong', 'Cool', 'Change', 'Yes']\n",
        "]\n",
        "\n",
        "attribute_names = [\n",
        "    'Sky',\n",
        "    'AirTemp',\n",
        "    'Humidity',\n",
        "    'Wind',\n",
        "    'Water',\n",
        "    'Forecast'\n",
        "]\n",
        "\n",
        "# Initial hypothesis\n",
        "hypothesis = ['0'] * len(attribute_names)\n",
        "\n",
        "# Store hypothesis changes for graph\n",
        "hypothesis_history = []\n",
        "positive_example_numbers = []\n",
        "\n",
        "print(\"FIND-S ALGORITHM\")\n",
        "print(\"-\" * 50)\n",
        "\n",
        "print(\"Initial Hypothesis:\", hypothesis)\n",
        "\n",
        "# FIND-S algorithm\n",
        "for i, example in enumerate(training_data, start=1):\n",
        "\n",
        "    # Check whether example is positive\n",
        "    if example[-1] == 'Yes':\n",
        "\n",
        "        for j in range(len(attribute_names)):\n",
        "\n",
        "            # First positive example\n",
        "            if hypothesis[j] == '0':\n",
        "                hypothesis[j] = example[j]\n",
        "\n",
        "            # If values are different, generalize to '?'\n",
        "            elif hypothesis[j] != example[j]:\n",
        "                hypothesis[j] = '?'\n",
        "\n",
        "        # Store the current hypothesis\n",
        "        hypothesis_history.append(hypothesis.copy())\n",
        "        positive_example_numbers.append(i)\n",
        "\n",
        "        print(\"After Example\", i, \":\", hypothesis)\n",
        "\n",
        "print(\"\\nFinal Most Specific Hypothesis:\")\n",
        "print(hypothesis)\n",
        "\n",
        "# ------------------------------------------------\n",
        "# Convert hypothesis into numerical values for graph\n",
        "# 0       = 0\n",
        "# Specific attribute = 1\n",
        "# '?'     = 2\n",
        "# ------------------------------------------------\n",
        "\n",
        "graph_values = []\n",
        "\n",
        "for h in hypothesis_history:\n",
        "\n",
        "    values = []\n",
        "\n",
        "    for value in h:\n",
        "        if value == '0':\n",
        "            values.append(0)\n",
        "        elif value == '?':\n",
        "            values.append(2)\n",
        "        else:\n",
        "            values.append(1)\n",
        "\n",
        "    graph_values.append(values)\n",
        "\n",
        "# ------------------------------------------------\n",
        "# Plot graph\n",
        "# ------------------------------------------------\n",
        "\n",
        "plt.figure(figsize=(10, 6))\n",
        "\n",
        "for i, attribute in enumerate(attribute_names):\n",
        "\n",
        "    values = [row[i] for row in graph_values]\n",
        "\n",
        "    plt.plot(\n",
        "        positive_example_numbers,\n",
        "        values,\n",
        "        marker='o',\n",
        "        linewidth=2,\n",
        "        label=attribute\n",
        "    )\n",
        "\n",
        "plt.yticks(\n",
        "    [0, 1, 2],\n",
        "    ['Initial (0)', 'Specific Value', 'Generalized (?)']\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Positive Training Example\")\n",
        "plt.ylabel(\"Hypothesis State\")\n",
        "plt.title(\"FIND-S Algorithm - Hypothesis Evolution\")\n",
        "\n",
        "plt.grid(True, linestyle='--', alpha=0.5)\n",
        "plt.legend()\n",
        "plt.tight_layout()\n",
        "\n",
        "plt.show()"
      ]
